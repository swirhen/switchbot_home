[Unit]
Description=SwitchBot Home API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swirhen
Group=swirhen
WorkingDirectory=/home/swirhen/switchbot_home/web
EnvironmentFile=-/etc/default/switchbot-home-api
ExecStart=/home/swirhen/switchbot_home/web/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# スケジュールの実行は本番だけで行う（手元の開発用サーバーでは動かさない）
Environment=SWITCHBOT_HOME_SCHEDULER=1

[Install]
WantedBy=multi-user.target
